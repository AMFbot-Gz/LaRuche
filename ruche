#!/usr/bin/env bash
# ruche — CLI La Ruche
# Usage: ./ruche <commande> [args]

set -euo pipefail

RUCHE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
QUEEN_URL="${QUEEN_URL:-http://localhost:3000}"

# ─── Couleurs ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# ─── Helpers ──────────────────────────────────────────────────────────────────
info()    { echo -e "${BLUE}[ruche]${NC} $*"; }
success() { echo -e "${GREEN}[ruche]${NC} $*"; }
warn()    { echo -e "${YELLOW}[ruche]${NC} $*"; }
error()   { echo -e "${RED}[ruche]${NC} $*" >&2; }

# ─── Commandes ────────────────────────────────────────────────────────────────

cmd_onboard() {
    echo -e "\n${PURPLE}=== La Ruche — Wizard Premier Lancement ===${NC}\n"

    # Vérifier les prérequis
    info "Vérification des prérequis..."

    if ! command -v node &>/dev/null; then
        error "Node.js non trouvé. Installez Node.js 20+ : https://nodejs.org"
        exit 1
    fi
    NODE_VER=$(node --version | tr -d 'v' | cut -d. -f1)
    if [ "$NODE_VER" -lt 20 ]; then
        warn "Node.js v$NODE_VER détecté. v20+ recommandé."
    else
        success "Node.js $(node --version) OK"
    fi

    if ! command -v python3 &>/dev/null; then
        error "Python3 non trouvé. Installez Python 3.11+"
        exit 1
    fi
    success "Python3 $(python3 --version | cut -d' ' -f2) OK"

    if ! command -v ollama &>/dev/null; then
        warn "Ollama non trouvé. Installez depuis https://ollama.ai pour LLM local."
    else
        success "Ollama $(ollama --version 2>/dev/null || echo 'installé') OK"
    fi

    # Créer .env si nécessaire
    if [ ! -f "$RUCHE_DIR/.env" ]; then
        if [ -f "$RUCHE_DIR/.env.example" ]; then
            cp "$RUCHE_DIR/.env.example" "$RUCHE_DIR/.env"
            success ".env créé depuis .env.example"
        else
            info "Création d'un .env basique..."
            cat > "$RUCHE_DIR/.env" << 'EOF'
# La Ruche — Configuration
ANTHROPIC_API_KEY=
QUEEN_PORT=3000
DASHBOARD_PORT=3001
OLLAMA_HOST=http://localhost:11434
NODE_ENV=development
EOF
            success ".env créé"
        fi
        warn "Éditez .env et ajoutez votre ANTHROPIC_API_KEY pour Claude Vision"
    else
        success ".env existant OK"
    fi

    echo -e "\n${GREEN}Onboarding terminé!${NC}"
    echo -e "Lance ${CYAN}make dev${NC} pour démarrer La Ruche"
    echo -e "Ou ${CYAN}docker compose up -d${NC} pour Docker\n"
}

cmd_mission() {
    local mission="${1:-}"
    if [ -z "$mission" ]; then
        error "Usage: ./ruche mission \"<description de la mission>\""
        exit 1
    fi

    info "Envoi de la mission à Queen..."
    if command -v curl &>/dev/null; then
        curl -s -X POST "$QUEEN_URL/api/mission" \
            -H "Content-Type: application/json" \
            -d "{\"mission\": $(echo "$mission" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))')}" \
            | python3 -m json.tool 2>/dev/null || echo "Réponse reçue (JSON invalide)"
    else
        error "curl non disponible"
        exit 1
    fi
}

cmd_health() {
    echo -e "\n${CYAN}=== La Ruche — Diagnostic Complet ===${NC}\n"

    SERVICES=(
        "Queen :3000|http://localhost:3000/api/health"
        "Dashboard :3001|http://localhost:3001"
        "Orchestration :8001|http://localhost:8001/health"
        "Perception :8002|http://localhost:8002/health"
        "Brain :8003|http://localhost:8003/health"
        "Executor :8004|http://localhost:8004/health"
        "Evolution :8005|http://localhost:8005/health"
        "Memory :8006|http://localhost:8006/health"
        "MCP Bridge :8007|http://localhost:8007/health"
        "Ollama :11434|http://localhost:11434/api/tags"
    )

    OK=0
    FAIL=0
    for entry in "${SERVICES[@]}"; do
        name="${entry%%|*}"
        url="${entry##*|}"
        if curl -sf --connect-timeout 2 "$url" &>/dev/null; then
            echo -e "  ${GREEN}OK${NC}  $name"
            ((OK++))
        else
            echo -e "  ${RED}DOWN${NC} $name"
            ((FAIL++))
        fi
    done

    echo ""
    echo -e "Services: ${GREEN}$OK OK${NC} / ${RED}$FAIL DOWN${NC}"
    echo ""
}

cmd_status() {
    cmd_health
}

cmd_logs() {
    info "Affichage des logs (Ctrl+C pour quitter)..."
    cd "$RUCHE_DIR"
    if [ -f docker-compose.yml ] && docker compose ps -q &>/dev/null 2>&1; then
        docker compose logs -f --tail=50
    else
        warn "Docker non actif. Utilisez 'make dev' pour les logs en mode dev."
    fi
}

cmd_help() {
    echo -e "\n${PURPLE}La Ruche${NC} — OS Agentique IA\n"
    echo "Usage: ./ruche <commande> [args]"
    echo ""
    echo "Commandes:"
    echo -e "  ${CYAN}onboard${NC}              Wizard premier lancement"
    echo -e "  ${CYAN}mission <texte>${NC}      Envoyer une mission à La Ruche"
    echo -e "  ${CYAN}health${NC}               Diagnostic complet de tous les services"
    echo -e "  ${CYAN}status${NC}               Alias de health"
    echo -e "  ${CYAN}logs${NC}                 Logs en direct"
    echo -e "  ${CYAN}help${NC}                 Afficher cette aide"
    echo ""
    echo "Commandes make:"
    echo -e "  ${CYAN}make dev${NC}             Lancer tout (Queen + Dashboard + Agents)"
    echo -e "  ${CYAN}make stop${NC}            Arrêter tous les services"
    echo -e "  ${CYAN}make test${NC}            Lancer les tests"
    echo ""
    echo "URLs:"
    echo -e "  Dashboard:  ${BLUE}http://localhost:3001${NC}"
    echo -e "  Queen API:  ${BLUE}http://localhost:3000${NC}"
    echo -e "  Agents:     ${BLUE}http://localhost:8001-8010${NC}"
    echo ""
}

# ─── Router principal ─────────────────────────────────────────────────────────

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    onboard)  cmd_onboard "$@" ;;
    mission)  cmd_mission "$@" ;;
    health)   cmd_health "$@" ;;
    status)   cmd_status "$@" ;;
    logs)     cmd_logs "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
        error "Commande inconnue: $COMMAND"
        cmd_help
        exit 1
        ;;
esac
