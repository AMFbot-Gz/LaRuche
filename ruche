    checks = []

    for tool, flag, major, minor in [
        ("node",    "--version", 20,  0),
        ("pnpm",    "--version",  8,  0),
        ("python3", "--version",  3, 11),
        ("uv",      "--version",  0,  0),
    ]:
        ok_val = check_version(tool, flag, major, minor)
        try:
            r = subprocess.run([tool, flag], capture_output=True, text=True, timeout=5)
            detail = (r.stdout + r.stderr).strip().split("\n")[0]
        except Exception:
            detail = "non trouvé"
        checks.append((tool, ok_val, detail))

    for label, url in [
        ("Ollama :11434",    "http://localhost:11434/api/tags"),
        ("Queen :3000",      "http://localhost:3000/api/health"),
        ("Dashboard :3001",  "http://localhost:3001"),
    ]:
        up = http_ok(url)
        checks.append((label, up, "en ligne" if up else "hors ligne"))

    redis_up = check_redis()
    checks.append(("Redis :6379", redis_up, "PONG" if redis_up else "hors ligne"))

    for name, agent in AGENTS.items():
        up = http_ok(f"http://localhost:{agent['port']}/health")
        checks.append((f"agent:{name}", up, "en ligne" if up else "hors ligne"))

    # Affichage aligné
    max_w = max(len(c[0]) for c in checks)
    for label, ok_val, detail in checks:
        status = f"{C.GREEN}OK  {C.NC}" if ok_val else f"{C.RED}FAIL{C.NC}"
        print(f"  {status}  {label:<{max_w}}  {C.DIM}{detail}{C.NC}")

    print()
    fails = [c for c in checks if not c[1]]
    if not fails:
        ok("Tous les services sont opérationnels")
    else:
        warn(f"{len(fails)} service(s) hors ligne : {', '.join(c[0] for c in fails)}")
        info("  Démarrez avec : ./ruche start")

    hr()
    print()


# ─── Commande : upgrade ────────────────────────────────────────────────────

def cmd_upgrade():
    """Mise à jour : git pull + pnpm install + uv sync + restart."""
    header("Mise à jour de La Ruche")
    hr()

    info("git pull origin main...")
    rc, out, err = run(["git", "pull", "origin", "main"])
    if rc == 0:
        ok("Code mis à jour")
        for line in out.splitlines():
            if line.strip():
                print(f"  {C.DIM}{line}{C.NC}")
    else:
        warn(f"git pull : {err.strip()[:200]}")

    info("pnpm install...")
    rc, _, err = run(["pnpm", "install", "--ignore-scripts"], capture=True)
    ok("Dépendances Node.js") if rc == 0 else warn(f"pnpm install : {err.strip()[:100]}")

    info("uv sync...")
    rc, _, err = run(["uv", "sync"], capture=True)
    ok("Dépendances Python") if rc == 0 else warn(f"uv sync : {err.strip()[:100]}")

    info("Redémarrage...")
    cmd_restart()

    ok("Mise à jour terminée !")


