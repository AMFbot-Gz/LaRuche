# ─── Main ──────────────────────────────────────────────────────────────────

def main():
    args = sys.argv[1:]

    if not args or args[0] in ("-h", "--help", "help"):
        print(HELP_TEXT)
        sys.exit(0)

    cmd = args[0].lower()

    try:
        if cmd == "onboard":
            cmd_onboard()
        elif cmd == "start":
            cmd_start()
        elif cmd == "stop":
            cmd_stop()
        elif cmd == "restart":
            cmd_restart()
        elif cmd == "status":
            cmd_status()
        elif cmd == "logs":
            svc = args[1] if len(args) > 1 else None
            cmd_logs(svc)
        elif cmd == "mission":
            if len(args) < 2:
                fail("Usage : ./ruche mission \"description de la mission\"")
                sys.exit(1)
            cmd_mission(" ".join(args[1:]))
        elif cmd == "models":
            cmd_models()
        elif cmd == "health":
            cmd_health()
        elif cmd == "upgrade":
            cmd_upgrade()
        else:
            fail(f"Commande inconnue : '{cmd}'")
            print(f"  Lancez {C.CYAN}./ruche --help{C.NC} pour voir les commandes disponibles.")
            sys.exit(1)
    except KeyboardInterrupt:
        print(f"\n{C.YELLOW}  Interrompu.{C.NC}")
        sys.exit(130)


if __name__ == "__main__":
    main()
