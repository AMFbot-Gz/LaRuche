def cmd_mission(mission_text: str):
    """Soumet une mission à la Queen."""
    header(f"Mission : {mission_text}")

    payload = json.dumps({"mission": mission_text, "mode": "auto"}).encode()
    url = "http://localhost:3000/api/mission"

    try:
        req = urllib.request.Request(
            url, data=payload,
            headers={"Content-Type": "application/json"},
            method="POST"
        )
        with urllib.request.urlopen(req, timeout=30) as resp:
            result = json.loads(resp.read())
            ok("Mission soumise !")
            print(f"\n{C.DIM}{json.dumps(result, indent=2, ensure_ascii=False)}{C.NC}")
    except urllib.error.URLError as e:
        fail(f"Impossible de joindre la Queen : {e}")
        info("  Vérifiez que la Queen est démarrée : ./ruche status")
        sys.exit(1)


