# ─── Utilitaires ───────────────────────────────────────────────────────────

def cmd_exists(name: str) -> bool:
    """Vérifie qu'une commande est disponible dans le PATH."""
    return shutil.which(name) is not None


def run(args, cwd=None, capture=False, env=None):
    """Lance une commande. Retourne (returncode, stdout, stderr)."""
    merged_env = {**os.environ, **(env or {})}
    r = subprocess.run(
        args, cwd=str(cwd or REPO_ROOT),
        capture_output=capture, text=True, env=merged_env
    )
    return r.returncode, r.stdout or "", r.stderr or ""


def run_bg(args, cwd=None, log_file=None, env=None) -> int:
    """Lance une commande en arrière-plan. Retourne le PID."""
    merged_env = {**os.environ, **(env or {})}
    if log_file:
        out_fh = open(str(log_file), "w")
        err_fh = open(str(log_file) + ".err", "w")
    else:
        out_fh = subprocess.DEVNULL
        err_fh = subprocess.DEVNULL
    p = subprocess.Popen(
        args, cwd=str(cwd or REPO_ROOT),
        stdout=out_fh, stderr=err_fh,
        env=merged_env, start_new_session=True
    )
    return p.pid


def write_pid(pid_file: str, pid: int):
    Path(pid_file).write_text(str(pid))


def read_pid(pid_file: str) -> Optional[int]:
    try:
        return int(Path(pid_file).read_text().strip())
    except Exception:
        return None


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def http_ok(url: str, timeout: float = 2.0) -> bool:
    """Vérifie qu'un endpoint HTTP répond (stdlib uniquement)."""
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return r.status < 500
    except Exception:
        return False


def load_env() -> dict:
    """Charge les variables depuis .env (si présent)."""
    env = {}
    env_file = REPO_ROOT / ".env"
    if env_file.exists():
        for line in env_file.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, _, v = line.partition("=")
                env[k.strip()] = v.strip().strip('"').strip("'")
    return env


def check_version(cmd: str, flag: str, major_min: int, minor_min: int = 0) -> bool:
    """Vérifie qu'un outil a une version suffisante."""
    try:
        r = subprocess.run([cmd, flag], capture_output=True, text=True, timeout=5)
        output = r.stdout + r.stderr
        m = re.search(r"(\d+)\.(\d+)", output)
        if m:
            major, minor = int(m.group(1)), int(m.group(2))
            return major > major_min or (major == major_min and minor >= minor_min)
    except Exception:
        pass
    return False


def check_redis() -> bool:
    try:
        r = subprocess.run(
            ["redis-cli", "ping"], capture_output=True, text=True, timeout=2
        )
        return "PONG" in r.stdout
    except Exception:
        return False


