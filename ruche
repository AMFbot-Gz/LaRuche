    print()
    hr()

    if ollama_ok:
        show_ollama_models()

    print()


# ─── Commande : logs ───────────────────────────────────────────────────────

def cmd_logs(service: Optional[str] = None):
    """Affiche les logs en temps réel."""
    log_map = {
        "queen":     LOG_DIR / "queen.log",
        "dashboard": LOG_DIR / "dashboard.log",
        **{name: LOG_DIR / f"{name}.log" for name in AGENTS},
    }

    if service:
        log_file = log_map.get(service.lower())
        if log_file and log_file.exists():
            info(f"Logs de {service} ({log_file}) — Ctrl+C pour quitter")
            os.execlp("tail", "tail", "-f", str(log_file))
        else:
            fail(f"Log introuvable pour '{service}'")
            info(f"  Disponibles : {', '.join(log_map.keys())}")
            sys.exit(1)
    else:
        log_files = [str(f) for f in LOG_DIR.glob("*.log")] if LOG_DIR.exists() else []
        if log_files:
            info("Logs de tous les services — Ctrl+C pour quitter")
            os.execlp("tail", "tail", "-f", *log_files)
        else:
            warn("Aucun log trouvé — les services sont-ils démarrés ?")
            info("  Lancez : ./ruche start")


