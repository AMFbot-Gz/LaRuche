def cmd_onboard():
    """Wizard d'installation interactif (inspiration clawdbot onboard)."""
    print(BANNER)
    print(f"{C.BOLD}  Bienvenue dans La Ruche !{C.NC}")
    print(f"  Ce wizard va tout configurer pas à pas.\n")
    hr()

    TOTAL = 6

    # ── Étape 1 : Prérequis ──────────────────────────────────────────────
    step(1, TOTAL, "Vérification des prérequis")
    all_ok = True

    checks = [
        ("node",   "Node.js >= 20",  lambda: check_version("node", "--version", 20)),
        ("pnpm",   "pnpm",           lambda: cmd_exists("pnpm")),
        ("python3","Python >= 3.11", lambda: check_version("python3", "--version", 3, 11)),
        ("uv",     "uv",             lambda: cmd_exists("uv")),
        ("ollama", "Ollama",         lambda: cmd_exists("ollama")),
        ("docker", "Docker",         lambda: cmd_exists("docker")),
    ]

    for binary, label, check in checks:
        try:
            result = check()
        except Exception:
            result = False
        if result:
            ok(f"{label}")
        else:
            if binary in ("node", "python3", "uv"):
                fail(f"{label} — REQUIS")
                all_ok = False
            else:
                warn(f"{label} — non trouvé (optionnel)")

    if not all_ok:
        print()
        fail("Prérequis manquants. Installez-les puis relancez.")
        info("  Lancez d'abord : bash install.sh")
        sys.exit(1)

    # ── Étape 2 : Configuration .env ─────────────────────────────────────
    step(2, TOTAL, "Configuration .env")
    env_file = REPO_ROOT / ".env"

    if not env_file.exists():
        example = REPO_ROOT / ".env.example"
        if example.exists():
            shutil.copy(str(example), str(env_file))
            ok(".env créé depuis .env.example")
        else:
            env_file.write_text("# La Ruche — Configuration\n")
            ok(".env créé")
    else:
        ok(".env existant trouvé")

    env = load_env()

    # Génération automatique des secrets manquants
    updated: dict = {}
    if not env.get("CHIMERA_SECRET") or env.get("CHIMERA_SECRET", "").startswith("CHANGE_ME"):
        updated["CHIMERA_SECRET"] = secrets.token_hex(32)
        ok("CHIMERA_SECRET généré automatiquement")
    if not env.get("DASHBOARD_TOKEN") or env.get("DASHBOARD_TOKEN", "").startswith("CHANGE_ME"):
        updated["DASHBOARD_TOKEN"] = secrets.token_hex(24)
        ok("DASHBOARD_TOKEN généré automatiquement")

    # Variables interactives
    print()
    info("Configurez vos clés API (Entrée = garder la valeur actuelle) :")
    print()

    interactive_vars = [
        ("ANTHROPIC_API_KEY",  "Clé Anthropic (sk-ant-...) — optionnel",  False),
        ("TELEGRAM_BOT_TOKEN", "Token Telegram @BotFather — optionnel",    False),
        ("ADMIN_TELEGRAM_ID",  "Votre Telegram ID numérique — optionnel",  False),
    ]

    for var, desc, required in interactive_vars:
        current = env.get(var, "")
        display = current[:8] + "..." if len(current) > 10 else (current or "(vide)")
        ask(f"{C.BOLD}{var}{C.NC} [{display}] — {desc} :")
        try:
            val = input().strip()
        except (EOFError, KeyboardInterrupt):
            val = ""
        if val:
            updated[var] = val

    # Applique les mises à jour dans .env
    if updated:
        lines = env_file.read_text().splitlines()
        new_lines = []
        written = set()
        for line in lines:
            stripped = line.strip()
            if stripped and not stripped.startswith("#") and "=" in stripped:
                k = stripped.split("=")[0].strip()
                if k in updated:
                    new_lines.append(f"{k}={updated[k]}")
                    written.add(k)
                    continue
            new_lines.append(line)
        for k, v in updated.items():
            if k not in written:
                new_lines.append(f"{k}={v}")
        env_file.write_text("\n".join(new_lines) + "\n")
        ok(f"{len(updated)} variable(s) sauvegardée(s) dans .env")

    # ── Étape 3 : Installation des dépendances ───────────────────────────
    step(3, TOTAL, "Installation des dépendances")

    info("pnpm install...")
    rc, _, err = run(["pnpm", "install", "--ignore-scripts"], capture=True)
    ok("Dépendances Node.js") if rc == 0 else warn(f"pnpm install : {err.strip()[:100]}")

    info("uv sync...")
    rc, _, err = run(["uv", "sync"], capture=True)
    ok("Dépendances Python") if rc == 0 else warn(f"uv sync : {err.strip()[:100]}")

    # ── Étape 4 : Démarrage ──────────────────────────────────────────────
    step(4, TOTAL, "Démarrage des services")
    ask("Démarrer La Ruche maintenant ? [O/n] :")
    try:
        ans = input().strip().lower()
    except (EOFError, KeyboardInterrupt):
        ans = "n"
    if ans in ("", "o", "oui", "y", "yes"):
        cmd_start()
    else:
        info("Services non démarrés — lancez : ./ruche start")

    # ── Étape 5 : Test Telegram ───────────────────────────────────────────
    step(5, TOTAL, "Test Telegram")
    env = load_env()
    tg_token = env.get("TELEGRAM_BOT_TOKEN", "").strip()
    tg_admin = env.get("ADMIN_TELEGRAM_ID", "").strip()

    if tg_token and tg_admin:
        ask("Envoyer un message Telegram de test ? [O/n] :")
        try:
            ans = input().strip().lower()
        except (EOFError, KeyboardInterrupt):
            ans = "n"
        if ans in ("", "o", "oui", "y", "yes"):
            _send_telegram_test(tg_token, tg_admin)
    else:
        info("Telegram non configuré — étape ignorée")
        info("  Ajoutez TELEGRAM_BOT_TOKEN + ADMIN_TELEGRAM_ID dans .env")

    # ── Étape 6 : Résumé final ────────────────────────────────────────────
    step(6, TOTAL, "Résumé")
    hr()
    print(f"\n{C.GREEN}{C.BOLD}  La Ruche est prête !{C.NC}\n")
    print(f"  {C.BOLD}URLs :{C.NC}")
    print(f"  Queen API    {C.CYAN}http://localhost:3000{C.NC}")
    print(f"  Dashboard    {C.CYAN}http://localhost:3001{C.NC}")
    print(f"  Agents       {C.CYAN}http://localhost:8001-8009{C.NC}")
    print(f"\n  {C.BOLD}Commandes utiles :{C.NC}")
    print(f"  {C.CYAN}./ruche status{C.NC}        — état des services")
    print(f"  {C.CYAN}./ruche health{C.NC}        — diagnostic complet")
    print(f"  {C.CYAN}./ruche logs{C.NC}          — logs en temps réel")
    print(f"  {C.CYAN}./ruche mission \"...\"  {C.NC} — soumettre une mission")
    hr()
    print()


def _send_telegram_test(token: str, chat_id: str):
    msg = "La Ruche est opérationnelle ! Les agents sont en ligne."
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    data = urllib.parse.urlencode({
        "chat_id": chat_id,
        "text": msg,
        "parse_mode": "HTML",
    }).encode()
    try:
        with urllib.request.urlopen(url, data=data, timeout=10) as resp:
            result = json.loads(resp.read())
            if result.get("ok"):
                ok("Message Telegram envoyé avec succès !")
            else:
                warn(f"Telegram API : {result.get('description', 'erreur')}")
    except Exception as e:
        warn(f"Impossible d'envoyer le message Telegram : {e}")


# ─── Commande : start ──────────────────────────────────────────────────────

def cmd_start():
    """Démarre tous les services (Queen + agents + dashboard)."""
    print(BANNER)
    header("Démarrage de La Ruche...")
    hr()

    LOG_DIR.mkdir(parents=True, exist_ok=True)

    # ── Queen (Node.js) ──────────────────────────────────────────────────
    queen_pid_file = "/tmp/chimera_queen.pid"
    queen_pid = read_pid(queen_pid_file)
    if queen_pid and pid_alive(queen_pid):
        ok(f"Queen déjà en cours (PID {queen_pid})")
    else:
        queen_js = REPO_ROOT / "apps" / "queen" / "src" / "queen_oss.js"
        if not queen_js.exists():
            warn(f"queen_oss.js introuvable : {queen_js}")
        else:
            log_file = LOG_DIR / "queen.log"
            pid = run_bg(
                ["node", str(queen_js)],
                cwd=queen_js.parent,
                log_file=log_file,
            )
            write_pid(queen_pid_file, pid)
            ok(f"Queen démarrée (PID {pid}) — {log_file}")

    # ── Agents Python (via make agents-up) ───────────────────────────────
    info("Démarrage des 9 agents Python (make agents-up)...")
    rc, out, err = run(["make", "agents-up"], capture=True)
    if rc == 0:
        ok("9 agents Python démarrés")
        for line in out.splitlines():
            if line.strip() and "✓" in line:
                print(f"  {C.DIM}{line.strip()}{C.NC}")
    else:
        warn(f"make agents-up a renvoyé une erreur : {err.strip()[:300]}")

    # ── Dashboard (Next.js) ──────────────────────────────────────────────
    dash_pid_file = "/tmp/chimera_dashboard.pid"
    dash_pid = read_pid(dash_pid_file)
    if dash_pid and pid_alive(dash_pid):
        ok(f"Dashboard déjà en cours (PID {dash_pid})")
    else:
        dash_dir = REPO_ROOT / "apps" / "dashboard"
        if not dash_dir.exists():
            warn("apps/dashboard introuvable")
        else:
            log_file = LOG_DIR / "dashboard.log"
            pid = run_bg(["pnpm", "dev"], cwd=dash_dir, log_file=log_file)
            write_pid(dash_pid_file, pid)
            ok(f"Dashboard démarré (PID {pid}) — {log_file}")

    print()
    hr()
    print(f"\n{C.GREEN}{C.BOLD}  La Ruche est en ligne !{C.NC}\n")
    print(f"  Queen API    {C.CYAN}http://localhost:3000{C.NC}")
    print(f"  Dashboard    {C.CYAN}http://localhost:3001{C.NC}")
    print(f"  Agents       {C.CYAN}http://localhost:8001-8009{C.NC}")
    print(f"  Logs         {C.DIM}/tmp/chimera_agents_logs/{C.NC}")
    hr()
    print()


# ─── Commande : stop ───────────────────────────────────────────────────────

def cmd_stop():
    """Arrête tous les services."""
    header("Arrêt de La Ruche...")

    # Queen + Dashboard
    for svc_name, svc in SERVICES.items():
        pid = read_pid(svc["pid_file"])
        if pid and pid_alive(pid):
            try:
                os.kill(pid, signal.SIGTERM)
                ok(f"{svc['name']} (PID {pid}) arrêté")
            except Exception as e:
                warn(f"Impossible d'arrêter {svc['name']} : {e}")
            Path(svc["pid_file"]).unlink(missing_ok=True)
        else:
            info(f"{svc['name']} : non actif")

    # Agents Python via make
    rc, _, _ = run(["make", "agents-down"], capture=True)
    ok("Agents Python arrêtés") if rc == 0 else info("Agents Python : déjà arrêtés")

    ok("La Ruche arrêtée")


# ─── Commande : restart ────────────────────────────────────────────────────

def cmd_restart():
    """Redémarre tous les services."""
    header("Redémarrage de La Ruche...")
    cmd_stop()
    time.sleep(2)
    cmd_start()


