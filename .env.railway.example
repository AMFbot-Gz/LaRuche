# ============================================================
# LaRuche — Variables d'environnement Railway (mode CLOUD)
# ============================================================
# Copiez ces variables dans :
#   railway.app → ton projet → Settings → Variables
# ============================================================

# ─── MODE ───────────────────────────────────────────────────
LARUCHE_MODE=cloud
STANDALONE_MODE=true
NODE_ENV=production
PORT=3000

# ─── LLM — Anthropic ────────────────────────────────────────
# Recharger sur : console.anthropic.com → Billing
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Base de données — Neon ─────────────────────────────────
# Créer sur : neon.tech → New Project → copier la connection string
DATABASE_URL=postgresql://user:pass@ep-xxx-yyy.us-east-2.aws.neon.tech/laruche?sslmode=require

# ─── Auth — Clerk ───────────────────────────────────────────
# Créer sur : clerk.com → Create application → API Keys
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ─── Billing — Stripe ───────────────────────────────────────
# Créer sur : stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAMS_PRICE_ID=

# ─── Telegram (optionnel en mode cloud) ─────────────────────
# Créer sur : t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# ─── CORS — URL Vercel ──────────────────────────────────────
# Remplacer par l'URL réelle du dashboard Vercel après déploiement
CORS_ORIGIN=https://laruche-dashboard.vercel.app

# ─── URLs agents Python ─────────────────────────────────────
# En mode cloud initial : agents désactivés (graceful degradation)
# Les circuits breakers gèrent les timeouts automatiquement
AGENT_ORCHESTRATION_URL=http://localhost:8001
AGENT_PERCEPTION_URL=http://localhost:8002
AGENT_BRAIN_URL=http://localhost:8003
AGENT_EXECUTOR_URL=http://localhost:8004
AGENT_EVOLUTION_URL=http://localhost:8005
AGENT_MEMORY_URL=http://localhost:8006
AGENT_MCP_BRIDGE_URL=http://localhost:8007

# ─── Sécurité ───────────────────────────────────────────────
# Générer : openssl rand -hex 32
CHIMERA_SECRET=
